# Copie para .env e preencha. O .env e' ignorado pelo git.

# Token com permissao de leitura em Analytics.
# Gere em: https://dash.cloudflare.com/profile/api-tokens
# Permissoes: Account > Account Analytics > Read
#             Zone > Analytics > Read
#             Zone > Zone > Read
CLOUDFLARE_API_TOKEN=

# Opcional. Sem ele, o script descobre a zona pelo nome do dominio
# (precisa da permissao Zone > Zone > Read).
# Fica no painel, na coluna da direita da pagina do dominio.
CLOUDFLARE_ZONE_ID=
