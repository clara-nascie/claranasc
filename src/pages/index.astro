---
import '../styles/global.css';

import { SITE } from '../data/siteData';
import Seo from '../components/seo/Seo.astro';
import LocalBusinessSchema from '../components/seo/LocalBusinessSchema.astro';

import { AppLayout } from '../components/layout/AppLayout';
import { Header } from '../components/sections/Header';
// Hero e Portfolio são Astro, não React: nenhum dos dois precisa de estado que
// justifique hidratar uma ilha. O filtro da galeria é DOM puro.
import Hero from '../components/sections/Hero.astro';
import Portfolio from '../components/sections/Portfolio.astro';
import { About } from '../components/sections/About';
import { ContactForm } from '../components/sections/ContactForm';
import { Footer } from '../components/sections/Footer';

import { Lightbox } from '../components/Lightbox';
import FloatingCta from '../components/FloatingCta.astro';

// Title com 57 caracteres: abaixo do limite de ~60 que o Google exibe sem cortar.
// Ordem intencional — "Tatuadora em BH" logo após o nome, porque é o termo de
// busca, e Blackwork antes dos outros nichos por ser a especialidade.
const title = 'Clara Nasc | Tatuadora em BH - Blackwork e Fine Line';
const description =
  'Tatuadora em Belo Horizonte especializada em Blackwork, Fine Line, Botânico, Geek & Animes e Coberturas. Veja o portfólio autoral e solicite seu orçamento pelo WhatsApp.';
---

<!DOCTYPE html>
<html lang={SITE.lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/favicon.png">

    <Seo title={title} description={description} />
    <LocalBusinessSchema />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Syne:wght@500;700;800&display=swap" rel="stylesheet">
</head>
<body>

    
    <AppLayout>
        <Header client:load />
        <Hero />
        <Portfolio />
        <About />
        <ContactForm client:load />
        <Footer />
        <Lightbox client:load />
        <FloatingCta />
    </AppLayout>

    <script>
        // Animações de entrada por scroll: adiciona .active quando o elemento
        // entra na viewport.
        //
        // Este script é um módulo, portanto já roda com `defer` — depois do parse
        // do documento e da hidratação do React. Como os ícones agora são SVG
        // renderizados pelo próprio React (e não injetados por um script externo
        // depois), o HTML do servidor e o do cliente batem: o React preserva os
        // nós em vez de recriá-los. É por isso que uma única passada basta e não
        // existe mais MutationObserver reobservando `document.body` a cada mutação.
        const scrollObserver = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                        // Uma vez revelado, não há motivo para continuar observando.
                        scrollObserver.unobserve(entry.target);
                    }
                }
            },
            { threshold: 0.15 }
        );

        const seletorRevelaveis = '.reveal, .fade-in, .fade-in-delay-1, .fade-in-delay-2, .fade-in-delay-3';
        for (const el of document.querySelectorAll(seletorRevelaveis)) {
            scrollObserver.observe(el);
        }
    </script>
</body>
</html>
