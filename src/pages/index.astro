---
import '../styles/global.css';

import { AppLayout } from '../components/layout/AppLayout';
import { Header } from '../components/sections/Header';
import { Hero } from '../components/sections/Hero';
import { Portfolio } from '../components/sections/Portfolio';
import { About } from '../components/sections/About';
import { ContactForm } from '../components/sections/ContactForm';
import { Footer } from '../components/sections/Footer';

import { Lightbox } from '../components/Lightbox';
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clara Nasc | Tatuadora em BH - Fine Line, Geek, Cobertura & Blackwork</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <meta name="description" content="Explore o portfólio de Clara Nasc, tatuadora em BH. Projetos autorais focados em Fine Line, Blackwork, universo Geek e Cobertura. Agende seu horário online.">
    <meta name="keywords" content="tatuadora, tattoo artist, fine line, blackwork, tatuagem delicada, clara nasc, claranasc, tatuagem sp, tattoo portfolio">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://claranasc.com/">
    <meta property="og:title" content="Clara Nasc | Tatuadora em BH">
    <meta property="og:description" content="Explore o portfólio de Clara Nasc, tatuadora em BH. Projetos autorais focados em Fine Line, Blackwork, universo Geek e Cobertura. Agende seu horário online.">
    <meta property="og:image" content="/assets/hero-bg.webp">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Syne:wght@500;700;800&display=swap" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
</head>
<body>

    
    <AppLayout>
        <Header client:load />
        <Hero />
        <Portfolio client:load />
        <About />
        <ContactForm client:load />
        <Footer />
        <Lightbox client:load />
    </AppLayout>

    <script is:inline>
        // Initialize Lucide icons
        document.addEventListener('DOMContentLoaded', () => {
            if (window.lucide) {
                window.lucide.createIcons();
            }
            
            const iconObserver = new MutationObserver((mutations, observer) => {
                let hasNewNodes = false;
                for (let mutation of mutations) {
                    if (mutation.addedNodes.length > 0) {
                        hasNewNodes = true;
                        break;
                    }
                }
                
                if (hasNewNodes && window.lucide) {
                    observer.disconnect();
                    window.lucide.createIcons();
                    observer.observe(document.body, { childList: true, subtree: true });
                }
            });
            iconObserver.observe(document.body, { childList: true, subtree: true });

            // Scroll animations (Intersection Observer)
            const scrollObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                    }
                });
            }, { threshold: 0.15 });

            const observeElements = () => {
                document.querySelectorAll('.reveal, .fade-in, .fade-in-delay-1, .fade-in-delay-2, .fade-in-delay-3').forEach((el) => {
                    scrollObserver.observe(el);
                });
            };

            observeElements();

            // Failsafe for React Hydration: When React replaces DOM nodes, re-observe them
            const layoutObserver = new MutationObserver(() => {
                observeElements();
            });
            layoutObserver.observe(document.body, { childList: true, subtree: true });
        });
    </script>
</body>
</html>
