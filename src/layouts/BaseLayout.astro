---
import '../styles/global.css';

import { SITE } from '../data/siteData';
import { CAMPANHA } from '../data/campanhaData';
import Seo from '../components/seo/Seo.astro';
import LocalBusinessSchema from '../components/seo/LocalBusinessSchema.astro';

import { AppLayout } from '../components/layout/AppLayout';
import { Header } from '../components/sections/Header';
import { Footer } from '../components/sections/Footer';
import { Lightbox } from '../components/Lightbox';
import FloatingCta from '../components/FloatingCta.astro';
import CampanhaFaixa from '../components/CampanhaFaixa.astro';
import CampanhaPopup from '../components/CampanhaPopup.astro';
import CampanhaFlutuante from '../components/CampanhaFlutuante.astro';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, ogType = 'website', noindex = false } = Astro.props;
---

<!DOCTYPE html>
<html lang={SITE.lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/favicon.png">

    <Seo title={title} description={description} ogType={ogType} noindex={noindex} />
    <LocalBusinessSchema />

    {/* Schema específico da página: breadcrumb, FAQ. */}
    <slot name="head" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Syne:wght@500;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <AppLayout>
        <div class="site-corpo">
            <CampanhaFaixa />
            <Header client:load />
            <slot />
            <Footer />
        </div>
        <Lightbox client:load />
        {!CAMPANHA.ativa && <FloatingCta />}
        <CampanhaFlutuante />
        <CampanhaPopup />
    </AppLayout>

    <script>
        // Animações de entrada por scroll: adiciona .active ao entrar na viewport.
        const scrollObserver = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                        scrollObserver.unobserve(entry.target);
                    }
                }
            },
            { threshold: 0, rootMargin: '0px 0px -12% 0px' }
        );

        const seletorRevelaveis = '.reveal, .fade-in, .fade-in-delay-1, .fade-in-delay-2, .fade-in-delay-3';
        for (const el of document.querySelectorAll(seletorRevelaveis)) {
            scrollObserver.observe(el);
        }
    </script>
</body>
</html>
