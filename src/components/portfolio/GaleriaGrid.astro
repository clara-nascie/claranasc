---
import { Image, getImage } from 'astro:assets';
import type { PortfolioItem } from '../../data/portfolioData';
import { antesDa } from '../../data/coberturasData';

interface Props {
  itens: PortfolioItem[];
  id?: string;
  layout?: 'grade' | 'masonry' | 'carrossel';
  /** A ampliação abre só a tatuagem tocada, com o antes quando houver. */
  antesDepois?: boolean;
}

const { itens, id, layout = 'grade', antesDepois = false } = Astro.props;
const eMasonry = layout === 'masonry';
const eCarrossel = layout === 'carrossel';

const ampliada = async (image: ImageMetadata) =>
  (await getImage({ src: image, width: 1400, format: 'webp' })).src;

const fotos = await Promise.all(
  itens.map(async (item) => {
    const antes = antesDepois ? antesDa(item) : undefined;
    return {
      item,
      antes,
      grande: await ampliada(item.image),
      antesGrande: antes ? await ampliada(antes.image) : undefined
    };
  })
);

const LARGURAS = [280, 380, 560, 760];
const TAMANHOS = eCarrossel
  ? '(max-width: 639px) 66vw, (max-width: 991px) 40vw, 280px'
  : '(max-width: 639px) 90vw, (max-width: 991px) 43vw, 380px';
---

<div
  class:list={[
    'portfolio-grid',
    eMasonry && 'portfolio-grid--masonry',
    eCarrossel && 'portfolio-grid--carrossel'
  ]}
  id={id}
  data-galeria={antesDepois ? 'por-foto' : ''}
>
  {fotos.map(({ item, antes, grande, antesGrande }) => (
    <figure class:list={['portfolio-item', eMasonry && 'portfolio-item--livre']} data-category={item.category}>
      <div class="portfolio-img-wrapper">
        <Image
          src={item.image}
          alt={item.alt}
          widths={LARGURAS}
          sizes={TAMANHOS}
          format="webp"
          quality={72}
          loading="lazy"
          decoding="async"
        />
        {antes && (
          <span class="cobertura-antes" data-antes>
            <Image
              src={antes.image}
              alt={antes.alt}
              widths={[120, 260]}
              sizes="(max-width: 639px) 24vw, 100px"
              format="webp"
              quality={72}
              loading="lazy"
              decoding="async"
            />
            <span class="cobertura-antes-rotulo">Antes</span>
          </span>
        )}
        <div class="portfolio-hover">
          <span class="item-category">{item.categoryLabel}</span>
          <h3 class="item-title">{item.title}</h3>
          <button
            type="button"
            class="btn-zoom lightbox-trigger"
            aria-label={antes ? `${item.title}: ver antes e depois` : `Ampliar imagem de ${item.title}`}
            data-src={grande}
            data-title={item.title}
            data-category={item.categoryLabel}
            data-antes-src={antesGrande}
            data-antes-alt={antes?.alt}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 3h6v6" />
              <path d="m21 3-7 7" />
              <path d="m3 21 7-7" />
              <path d="M9 21H3v-6" />
            </svg>
          </button>
        </div>
      </div>
    </figure>
  ))}
</div>

<script>
  import '../../lib/gestosDaGaleria';
</script>
