---
import { Image, getImage } from 'astro:assets';
import type { PortfolioItem } from '../../data/portfolioData';


interface Props {
  itens: PortfolioItem[];
  id?: string;
  layout?: 'grade' | 'masonry' | 'carrossel';
}

const { itens, id, layout = 'grade' } = Astro.props;
const eMasonry = layout === 'masonry';
const eCarrossel = layout === 'carrossel';

const ampliadas = new Map(
  await Promise.all(
    itens.map(async (item) => {
      const grande = await getImage({ src: item.image, width: 1400, format: 'webp' });
      return [item.id, grande.src] as const;
    })
  )
);

const LARGURAS = [280, 380, 560, 760];
const TAMANHOS = eCarrossel
  ? '(max-width: 639px) 66vw, (max-width: 991px) 40vw, 280px'
  : '(max-width: 639px) 90vw, (max-width: 991px) 43vw, 380px';
---

<div
  class:list={[
    'portfolio-grid',
    eMasonry && 'portfolio-grid--masonry',
    eCarrossel && 'portfolio-grid--carrossel'
  ]}
  id={id}
  data-galeria
>
  {itens.map((item) => (
    <figure class:list={['portfolio-item', eMasonry && 'portfolio-item--livre']} data-category={item.category}>
      <div class="portfolio-img-wrapper">
        <Image
          src={item.image}
          alt={item.alt}
          widths={LARGURAS}
          sizes={TAMANHOS}
          format="webp"
          quality={72}
          loading="lazy"
          decoding="async"
        />
        <div class="portfolio-hover">
          <span class="item-category">{item.categoryLabel}</span>
          <h3 class="item-title">{item.title}</h3>
          <button
            type="button"
            class="btn-zoom lightbox-trigger"
            aria-label={`Ampliar imagem de ${item.title}`}
            data-src={ampliadas.get(item.id)}
            data-title={item.title}
            data-category={item.categoryLabel}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 3h6v6" />
              <path d="m21 3-7 7" />
              <path d="m3 21 7-7" />
              <path d="M9 21H3v-6" />
            </svg>
          </button>
        </div>
      </div>
    </figure>
  ))}
</div>

<script>
  /* Abaixo disso o gesto é um toque, não uma pressão: sem a espera, encostar
     numa foto para rolar a página já a abriria. */
  const PRESSAO_MS = 250;
  /* Todo arrasto começa com o dedo em cima de uma foto. Passou daqui, a pessoa
     está rolando a página ou o carrossel, e a espiada é cancelada. */
  const TOLERANCIA_PX = 10;

  function dadosDaFoto(gatilho: HTMLElement) {
    return {
      src: gatilho.dataset.src,
      title: gatilho.dataset.title,
      category: gatilho.dataset.category
    };
  }

  for (const grade of document.querySelectorAll<HTMLElement>('[data-galeria]')) {
    let temporizador: number | null = null;
    let espiando = false;
    let inicio = { x: 0, y: 0 };

    const cancelarEspera = () => {
      if (temporizador === null) return;
      clearTimeout(temporizador);
      temporizador = null;
    };

    const encerrarEspiada = () => {
      cancelarEspera();
      if (!espiando) return;
      espiando = false;
      window.dispatchEvent(new CustomEvent('close-lightbox'));
    };

    grade.addEventListener('pointerdown', (evento) => {
      const item = (evento.target as HTMLElement).closest<HTMLElement>('.portfolio-item');
      const gatilho = item?.querySelector<HTMLElement>('.lightbox-trigger');
      if (!gatilho) return;

      inicio = { x: evento.clientX, y: evento.clientY };
      temporizador = window.setTimeout(() => {
        temporizador = null;
        espiando = true;
        window.dispatchEvent(
          new CustomEvent('open-lightbox', {
            detail: { ...dadosDaFoto(gatilho), espiada: true }
          })
        );
      }, PRESSAO_MS);
    });

    /* `pointerup` vai para o elemento sob o dedo, e com a ampliação aberta esse
       elemento é o modal, não a galeria. Por isso a soltura é escutada na
       janela: na grade ela simplesmente não chegaria. */
    window.addEventListener('pointerup', encerrarEspiada);
    window.addEventListener('pointercancel', encerrarEspiada);

    window.addEventListener('pointermove', (evento) => {
      if (temporizador === null) return;
      const dx = evento.clientX - inicio.x;
      const dy = evento.clientY - inicio.y;
      if (Math.hypot(dx, dy) > TOLERANCIA_PX) cancelarEspera();
    });

    /* O menu nativo de "salvar imagem" abre na pressão longa e rouba o gesto
       antes de ele virar espiada. */
    grade.addEventListener('contextmenu', (evento) => {
      if ((evento.target as HTMLElement).closest('.portfolio-item')) evento.preventDefault();
    });

    grade.addEventListener('click', (evento) => {
      const gatilho = (evento.target as HTMLElement).closest<HTMLElement>('.lightbox-trigger');
      if (!gatilho) return;

      window.dispatchEvent(
        new CustomEvent('open-lightbox', { detail: dadosDaFoto(gatilho) })
      );
    });
  }
</script>
