---
import { SITE, LICENCIAMENTO } from '../../data/siteData';
import type { PortfolioItem } from '../../data/portfolioData';

/**
 * Declara ao Google quem é o dono de cada foto.
 *
 * ⚠️ Titularidade não cabe no sitemap de imagens: `<image:license>`,
 * `<image:title>` e `<image:caption>` foram descontinuadas em 2022, e hoje só
 * `<image:loc>` é lida. Só chega por dados estruturados.
 *
 * O `creator` referencia o nó da Clara por `@id`, já declarado no
 * `LocalBusinessSchema` da mesma página, em vez de repetir o cadastro por foto.
 */

interface Props {
  fotos: PortfolioItem[];
}

const { fotos } = Astro.props;

const paginaDeLicenca = new URL(LICENCIAMENTO.caminho, SITE.url).href;
const personId = `${SITE.url}/#clara`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': fotos.map((foto) => ({
    '@type': 'ImageObject',
    contentUrl: new URL(foto.image.src, SITE.url).href,
    name: foto.title,
    description: foto.alt,
    license: paginaDeLicenca,
    acquireLicensePage: paginaDeLicenca,
    creditText: LICENCIAMENTO.credito,
    copyrightNotice: LICENCIAMENTO.aviso,
    creator: { '@id': personId }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
