---
import { SITE, LICENCIAMENTO } from '../../data/siteData';
import type { PortfolioItem } from '../../data/portfolioData';

/**
 * Declara ao Google quem é o dono de cada foto.
 *
 * O sitemap de imagens não serve para isso: as tags `<image:license>`,
 * `<image:title>` e `<image:caption>` foram descontinuadas pelo Google em 2022,
 * e hoje só `<image:loc>` é lida. Titularidade só chega por dados estruturados
 * (ou por metadado IPTC dentro do arquivo, que exigiria reprocessar as 176).
 *
 * O `creator` aponta para o nó da Clara por `@id` em vez de repetir nome, foto
 * e redes em cada uma das fotos. Um `@id` que já existe no `LocalBusinessSchema`
 * da mesma página é a forma de dizer "é esta pessoa" sem duplicar o cadastro.
 */

interface Props {
  fotos: PortfolioItem[];
}

const { fotos } = Astro.props;

const paginaDeLicenca = new URL(LICENCIAMENTO.caminho, SITE.url).href;
const personId = `${SITE.url}/#clara`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': fotos.map((foto) => ({
    '@type': 'ImageObject',
    contentUrl: new URL(foto.image.src, SITE.url).href,
    name: foto.title,
    description: foto.alt,
    license: paginaDeLicenca,
    acquireLicensePage: paginaDeLicenca,
    creditText: LICENCIAMENTO.credito,
    copyrightNotice: LICENCIAMENTO.aviso,
    creator: { '@id': personId }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
