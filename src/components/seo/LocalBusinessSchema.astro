---
import { SITE, CONTACT, LOCATION, SOCIAL, OPENING_HOURS, OG_IMAGE } from '../../data/siteData';
import { PORTFOLIO_CATEGORIES } from '../../data/portfolioData';
import fotoArtista from '../../assets/about-artist.webp';

const businessId = `${SITE.url}/#business`;
const personId = `${SITE.url}/#clara`;

const sameAs = [SOCIAL.instagram, SOCIAL.tiktok].filter(
  (url): url is string => typeof url === 'string' && url.length > 0
);

const services = PORTFOLIO_CATEGORIES.filter((cat) => cat.id !== 'all').map((cat) => ({
  '@type': 'Offer',
  itemOffered: {
    '@type': 'Service',
    name: `Tatuagem ${cat.label}`,
    serviceType: cat.label,
    provider: { '@id': businessId },
    areaServed: LOCATION.areaServed.map((name) => ({ '@type': 'City', name }))
  }
}));

const business: Record<string, unknown> = {
  '@type': 'TattooParlor',
  '@id': businessId,
  name: SITE.businessName,
  url: SITE.url,
  image: new URL(OG_IMAGE.path, SITE.url).href,
  telephone: CONTACT.telephone,
  ...(CONTACT.email ? { email: CONTACT.email } : {}),
  priceRange: SITE.priceRange,
  currenciesAccepted: 'BRL',
  description:
    'Estúdio de tatuagem autoral em Belo Horizonte especializado em Blackwork, Fine Line, Botânico, Geek & Animes e Coberturas de tatuagens antigas.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: LOCATION.city,
    addressRegion: LOCATION.region,
    addressCountry: LOCATION.country,
    ...(LOCATION.streetAddress ? { streetAddress: LOCATION.streetAddress } : {}),
    ...(LOCATION.postalCode ? { postalCode: LOCATION.postalCode } : {})
  },
  areaServed: LOCATION.areaServed.map((name) => ({ '@type': 'City', name })),
  founder: { '@id': personId },
  employee: { '@id': personId },
  makesOffer: services,
  ...(LOCATION.geo
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: LOCATION.geo.latitude,
          longitude: LOCATION.geo.longitude
        }
      }
    : {}),
  ...(OPENING_HOURS
    ? {
        openingHoursSpecification: OPENING_HOURS.map((slot) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: slot.days,
          opens: slot.opens,
          closes: slot.closes
        }))
      }
    : {}),
  ...(sameAs.length > 0 ? { sameAs } : {})
};

const person: Record<string, unknown> = {
  '@type': 'Person',
  '@id': personId,
  name: SITE.name,
  jobTitle: SITE.jobTitle,
  url: SITE.url,
  image: new URL(fotoArtista.src, SITE.url).href,
  description:
    'Tatuadora em Belo Horizonte há 5 anos, com traço que une delicadeza e contraste. Cria arte autoral a partir das referências levadas por cada cliente.',
  worksFor: { '@id': businessId },
  knowsAbout: ['Blackwork', 'Fine Line', 'Tatuagem Botânica', 'Tatuagem Geek', 'Cobertura de Tatuagem'],
  ...(sameAs.length > 0 ? { sameAs } : {})
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  inLanguage: SITE.lang,
  publisher: { '@id': businessId }
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [business, person, website]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
