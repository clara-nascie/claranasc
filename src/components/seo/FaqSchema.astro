---
/**
 * JSON-LD `FAQPage`.
 *
 * ⚠️ Toda pergunta e resposta daqui PRECISA estar visível na página. Texto que
 * só existe no schema é conteúdo oculto — infração de política, não otimização.
 * Coberto por `npm run verificar:nichos`.
 *
 * Não gera resultado expandido no Google (restrito a governo e saúde desde
 * 2023). Ver docs/arquitetura/arquitetura.md.
 */
import type { PerguntaFrequente } from '../../data/nichosData';

interface Props {
  perguntas: PerguntaFrequente[];
}

const { perguntas } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: perguntas.map((item) => ({
    '@type': 'Question',
    name: item.pergunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.resposta
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
