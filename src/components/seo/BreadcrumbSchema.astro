---
/**
 * JSON-LD `BreadcrumbList` — troca a URL crua no resultado do Google pela
 * trilha legível.
 *
 * ⚠️ Precisa espelhar a trilha visível na página. Quem chama monta as duas a
 * partir da mesma lista.
 */
import { SITE } from '../../data/siteData';

export interface Rastro {
  nome: string;
  /** Caminho relativo, como `/tatuagem/blackwork`. Vira URL absoluta aqui. */
  caminho: string;
}

interface Props {
  itens: Rastro[];
}

const { itens } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: itens.map((item, indice) => ({
    '@type': 'ListItem',
    // `position` começa em 1, não em 0.
    position: indice + 1,
    name: item.nome,
    item: new URL(item.caminho, SITE.url).href
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
