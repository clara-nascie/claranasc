---
/**
 * Botão flutuante de agendamento.
 *
 * Mantém o CTA principal sempre ao alcance sem fixar o cabeçalho — o header
 * rola junto com a página por decisão de design, preservando o hero limpo.
 *
 * É um componente Astro, não React, de propósito: o comportamento é uma classe
 * alternada por scroll, o que não justifica o custo de hidratar React só por isso.
 * O `<script>` abaixo é empacotado pelo Astro e roda com `defer`.
 */
---

<a
  href="#contato"
  class="floating-cta"
  id="floating-cta"
  aria-label="Ir para o formulário de orçamento e agendamento"
>
  {/* SVG inline do ícone `calendar-plus` do Lucide, extraído do pacote
      lucide-react para ficar idêntico aos ícones dos componentes React.
      Inline em vez de <i data-lucide>: qualquer script que substitua nós do DOM
      após a renderização quebra a hidratação do React. */}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-calendar-plus"
    aria-hidden="true"
  >
    <path d="M16 19h6"></path>
    <path d="M16 2v4"></path>
    <path d="M19 16v6"></path>
    <path d="M21 12.598V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8.5"></path>
    <path d="M3 10h18"></path>
    <path d="M8 2v4"></path>
  </svg>
  <span>Agendar Sessão</span>
</a>

<script>
  const cta = document.getElementById('floating-cta');

  if (cta) {
    const hero = document.getElementById('home');
    // Onde o botão seria redundante: o próprio formulário e o rodapé, que já
    // tem contato de WhatsApp.
    const hideZones = [
      document.getElementById('contato'),
      document.querySelector('.main-footer')
    ].filter((el): el is Element => el !== null);

    let pastHero = !hero;
    const visibleHideZones = new Set<Element>();

    const update = () => {
      cta.classList.toggle('is-visible', pastHero && visibleHideZones.size === 0);
    };

    // IntersectionObserver em vez de listener de scroll: o navegador avisa
    // quando o cruzamento acontece, sem rodar código a cada pixel rolado.
    //
    // O gatilho é `intersectionRatio`, não `isIntersecting`, de propósito.
    // `isIntersecting` exige que o hero saia por completo da viewport, e esse é
    // um limiar exato: quando a base do hero fica em y=0, a área de interseção
    // tem altura zero e o navegador ainda o reporta como visível. Resultado, já
    // medido: o botão não aparecia ao rolar a galeria para o topo da tela.
    // Com proporção, "o hero praticamente saiu" é um estado robusto.
    const LIMITE_HERO = 0.2;
    if (hero) {
      new IntersectionObserver(
        ([entry]) => {
          pastHero = entry.intersectionRatio < LIMITE_HERO;
          update();
        },
        { threshold: [0, LIMITE_HERO, 1] }
      ).observe(hero);
    }

    for (const zone of hideZones) {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) visibleHideZones.add(zone);
        else visibleHideZones.delete(zone);
        update();
      }).observe(zone);
    }

    update();
  }
</script>
