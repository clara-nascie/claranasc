---
/**
 * Botão flutuante de agendamento.
 */
---


<a
  href="/#contato"
  class="floating-cta"
  id="floating-cta"
  aria-label="Ir para o formulário de orçamento e agendamento"
  >
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-calendar-plus"
    aria-hidden="true"
  >
    <path d="M16 19h6"></path>
    <path d="M16 2v4"></path>
    <path d="M19 16v6"></path>
    <path d="M21 12.598V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8.5"></path>
    <path d="M3 10h18"></path>
    <path d="M8 2v4"></path>
  </svg>
  <span>Agendar Sessão</span>
</a>

<script>
  const cta = document.getElementById('floating-cta');

  if (cta) {
    const hero = document.querySelector('[data-cta-apos]');
    const hideZones = [
      document.getElementById('contato'),
      document.querySelector('.main-footer')
    ].filter((el): el is Element => el !== null);

    let pastHero = !hero;
    const visibleHideZones = new Set<Element>();

    const update = () => {
      cta.classList.toggle('is-visible', pastHero && visibleHideZones.size === 0);
    };

    const LIMITE_HERO = 0.2;
    if (hero) {
      new IntersectionObserver(
        ([entry]) => {
          pastHero = entry.intersectionRatio < LIMITE_HERO;
          update();
        },
        { threshold: [0, LIMITE_HERO, 1] }
      ).observe(hero);
    }

    for (const zone of hideZones) {
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) visibleHideZones.add(zone);
        else visibleHideZones.delete(zone);
        update();
      }).observe(zone);
    }

    update();
  }
</script>
