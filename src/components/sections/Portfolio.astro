---
import { itensDestaque, PORTFOLIO_CATEGORIES } from '../../data/portfolioData';
import { NICHOS, caminhoDoNicho, rotuloDoNicho } from '../../data/nichosData';
import GaleriaGrid from '../portfolio/GaleriaGrid.astro';

/**
 * A galeria da home. A grade está em `GaleriaGrid.astro`, compartilhada com as
 * páginas por nicho; aqui fica só o que é da home — filtros e links por estilo.
 */
---

<section class="portfolio-section" id="portfolio">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">Galeria</span>
      <h2 class="section-title">Trabalhos Recentes</h2>
      <div class="header-divider"></div>
    </div>

    <div class="portfolio-filters reveal" role="tablist" aria-label="Filtros de categoria do portfólio">
      {PORTFOLIO_CATEGORIES.map((cat) => (
        <button
          type="button"
          role="tab"
          id={`filtro-${cat.id}`}
          aria-selected={cat.id === 'all'}
          aria-controls="portfolio-grid"
          class={`filter-btn${cat.id === 'all' ? ' active' : ''}`}
          data-filtro={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <div class="reveal">
      {/* Só a camada de destaque: 6 por categoria. As páginas por nicho é que
          mostram o acervo inteiro. */}
      <GaleriaGrid itens={itensDestaque} id="portfolio-grid" layout="grade" />
    </div>

    {/* Link recíproco: sem isto as cinco páginas ficam órfãs para o Google.
        A lista sai de NICHOS porque "Todos" não tem página e o slug da URL nem
        sempre é o id da categoria (`fineline` no código, `fine-line` na URL). */}
    <nav class="portfolio-nichos reveal" aria-label="Páginas por estilo de tatuagem">
      <h3>Ver por estilo</h3>
      <ul>
        {NICHOS.map((nicho) => (
          <li>
            <a href={caminhoDoNicho(nicho)}>{rotuloDoNicho(nicho)}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<script>
  // Filtro por categoria. Fica aqui e não no GaleriaGrid porque só a home
  // filtra — as páginas por nicho já chegam filtradas pela URL.
  const grade = document.getElementById('portfolio-grid');
  const botoesFiltro = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');

  if (grade) {
    const itens = Array.from(grade.querySelectorAll<HTMLElement>('.portfolio-item'));

    for (const botao of botoesFiltro) {
      botao.addEventListener('click', () => {
        const alvo = botao.dataset.filtro;

        for (const outro of botoesFiltro) {
          const ativo = outro === botao;
          outro.classList.toggle('active', ativo);
          outro.setAttribute('aria-selected', String(ativo));
        }

        // `.hidden` já existe no portfolio.css e resolve para `display: none`.
        for (const item of itens) {
          item.classList.toggle('hidden', alvo !== 'all' && item.dataset.category !== alvo);
        }
      });
    }
  }
</script>
