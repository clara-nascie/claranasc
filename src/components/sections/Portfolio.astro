---
import {
  itensDestaque,
  portfolioItems,
  PORTFOLIO_CATEGORIES
} from '../../data/portfolioData';
import { nichoDaCategoria, caminhoDoNicho } from '../../data/nichosData';
import GaleriaGrid from '../portfolio/GaleriaGrid.astro';

/**
 * A galeria da home: um carrossel por categoria.
 *
 * Cada fileira mostra 3 fotos em destaque e termina num cartão com o link para
 * a página do nicho, que traz o acervo inteiro. Ver `docs/arquitetura/`,
 * seção "As seis páginas".
 */

/** Categorias de verdade — 'all' é só o botão de filtro. */
const categorias = PORTFOLIO_CATEGORIES.filter((cat) => cat.id !== 'all');

const fileiras = categorias.map((cat) => ({
  ...cat,
  fotos: itensDestaque.filter((item) => item.category === cat.id),
  // O total do acervo, não o do destaque: é ele que anuncia o volume no botão.
  total: portfolioItems.filter((item) => item.category === cat.id).length,
  caminho: (() => {
    const nicho = nichoDaCategoria(cat.id);
    return nicho ? caminhoDoNicho(nicho) : '/';
  })()
}));
---

<section class="portfolio-section" id="portfolio">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">Galeria</span>
      <h2 class="section-title">Trabalhos Recentes</h2>
      <div class="header-divider"></div>
    </div>

    <div class="portfolio-filters reveal" role="tablist" aria-label="Filtros de categoria do portfólio">
      {PORTFOLIO_CATEGORIES.map((cat) => (
        <button
          type="button"
          role="tab"
          id={`filtro-${cat.id}`}
          aria-selected={cat.id === 'all'}
          aria-controls="portfolio-carrosseis"
          class={`filter-btn${cat.id === 'all' ? ' active' : ''}`}
          data-filtro={cat.id}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <div id="portfolio-carrosseis">
      {fileiras.map((fileira) => (
        <section class="carrossel reveal" data-category={fileira.id} aria-labelledby={`fileira-${fileira.id}`}>
          <h3 class="carrossel-titulo" id={`fileira-${fileira.id}`}>{fileira.label}</h3>

          {/*
            `scroll-snap` puro, sem JavaScript: no desktop as 3 fotos e o cartão
            cabem lado a lado e não há o que rolar; no celular transbordam e a
            visitante arrasta com o dedo.

            Não é um widget de carrossel — não avança sozinho, não tem bolinhas
            e nada fica escondido. Um contêiner que rola já vem com teclado,
            leitor de tela e busca funcionando; widget com autoplay precisa
            reconstruir os três e costuma errar.
          */}
          <div class="carrossel-trilho">
            <GaleriaGrid itens={fileira.fotos} layout="carrossel" />

            <a class="carrossel-cartao" href={fileira.caminho}>
              <span class="carrossel-cartao-rotulo">Ver todas</span>
              <span class="carrossel-cartao-total">{fileira.total} trabalhos</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </section>
      ))}
    </div>
  </div>
</section>

<script>
  // Filtro por categoria: esconde as fileiras que não são a escolhida.
  // Antes escondia foto por foto; com uma fileira por categoria, o alvo é a
  // fileira inteira — e o `.hidden` do portfolio.css resolve os dois.
  const botoesFiltro = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const fileiras = document.querySelectorAll<HTMLElement>('.carrossel[data-category]');

  for (const botao of botoesFiltro) {
    botao.addEventListener('click', () => {
      const alvo = botao.dataset.filtro;

      for (const outro of botoesFiltro) {
        const ativo = outro === botao;
        outro.classList.toggle('active', ativo);
        outro.setAttribute('aria-selected', String(ativo));
      }

      for (const fileira of fileiras) {
        fileira.classList.toggle('hidden', alvo !== 'all' && fileira.dataset.category !== alvo);
      }
    });
  }
</script>
