---
import { LOCATION, enderecoLinha, mapsUrl } from '../../data/siteData';

/** Hero tipográfico sobre fundo desenhado. Ver `docs/design/decisoes-visuais.md`. */
---

{/* `data-cta-apos`: o botão flutuante só aparece depois deste bloco. */}
<section class="hero-section" id="home" data-cta-apos>
  <div class="hero-grid">
    <div class="hero-content">
      <span class="hero-tagline fade-in">Blackwork, Fine Line, Botânico, Geek &amp; Coberturas</span>
      {/* As duas linhas ficam dentro do mesmo H1: para o Google, ele conta
          como um título só, com o nome e o termo de busca juntos. */}
      <h1 class="hero-title fade-in-delay-1">
        <span class="hero-title-name">Clara Nasc</span>
        <span class="hero-title-role">Tatuadora em Belo Horizonte</span>
      </h1>
      <p class="hero-subtitle fade-in-delay-2">
        A resposta para a vida, o universo e tudo mais é sempre uma tatuagem nova!
      </p>

      {/* Na tela aparece só o nome do estúdio; o endereço completo vai no
          `aria-label`, que é o nome acessível do link.

          ⚠️ O endereço sai de `enderecoLinha()`, nunca escrito à mão: o Google
          cruza o do site com o do Business Profile, e duas grafias do mesmo
          lugar enfraquecem essa associação. */}
      <address class="hero-endereco fade-in-delay-2">
        <a
          href={mapsUrl()}
          target="_blank"
          rel="noopener"
          aria-label={`${LOCATION.studioName} — ${enderecoLinha()}. Abrir no Google Maps`}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>{LOCATION.studioName}</span>
        </a>
      </address>
      <div class="hero-actions fade-in-delay-3">
        <a href="#contato" class="btn btn-primary" id="hero-cta-btn">
          <span>Orçamento &amp; Agendamento</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a href="#portfolio" class="btn btn-secondary" id="hero-secondary-btn">
          Ver Portfólio
        </a>
      </div>
    </div>

    {/* ⚠️ Elemento de verdade, não pseudo-elemento: no layout empilhado o
        crisântemo precisa entrar no fluxo, abaixo do texto. Posicionado, ele
        alcançava o subtítulo em alguma largura e derrubava o contraste a
        2,10:1 — a altura do hero varia com o número de linhas, então nenhum
        deslocamento serve para todas. */}
    <div class="hero-flor" aria-hidden="true"></div>
  </div>
</section>
