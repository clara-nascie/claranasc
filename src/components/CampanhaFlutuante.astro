---
import { CAMPANHA } from '../data/campanhaData';

const naPaginaDaCampanha = Astro.url.pathname.replace(/\/?$/, '/') === CAMPANHA.caminho;
---

{CAMPANHA.ativa && !naPaginaDaCampanha && (
  <a href={CAMPANHA.caminho} class="campanha-flutuante" id="campanha-flutuante">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
      <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
    </svg>
    <span>{CAMPANHA.nome}</span>
  </a>
)}

<script>
  const botao = document.getElementById('campanha-flutuante');

  if (botao) {
    const zonasVisiveis = new Set<Element>();
    const zonas = [document.getElementById('contato'), document.querySelector('.main-footer')];

    for (const zona of zonas) {
      if (!zona) continue;
      new IntersectionObserver(([entrada]) => {
        if (entrada.isIntersecting) zonasVisiveis.add(zona);
        else zonasVisiveis.delete(zona);
        botao.classList.toggle('is-oculto', zonasVisiveis.size > 0);
      }).observe(zona);
    }
  }
</script>
