{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claranasc",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Só estas rotas passam pelo Worker. O resto do site continua sendo
    // entregue direto pelo servidor de assets, como antes de existir Worker.
    "run_worker_first": ["/api/*", "/r/*"]
  },
  // Destino dos commits do painel /admin. O GITHUB_TOKEN é secret, não entra aqui.
  "vars": {
    "GITHUB_REPO": "clara-nascie/claranasc",
    "GITHUB_BRANCH": "main",
    // Do aplicativo "Painel admin" no Zero Trust. O team domain NÃO é o nome
    // da organização: é o endereço para onde o login redireciona.
    "ACCESS_TEAM_DOMAIN": "https://square-wind-1f90.cloudflareaccess.com",
    "ACCESS_AUD": "03135ef1810035ba08538dd836d42b6842eeda574fc502021e337d29ce943536"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // ⚠️ O bucket precisa existir ANTES do primeiro push, senão o deploy falha.
  // Ver docs/arquitetura/referencias-do-orcamento.md.
  "r2_buckets": [
    {
      "binding": "REFERENCIAS",
      "bucket_name": "claranasc-referencias"
    }
  ],
  // 5 envios por minuto por IP. O endereço de upload é público, e sem isto
  // uma única máquina encheria o bucket.
  "ratelimits": [
    {
      "name": "LIMITE_UPLOAD",
      "namespace_id": "1",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
